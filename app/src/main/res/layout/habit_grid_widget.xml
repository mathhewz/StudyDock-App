<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habit_widget_root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="#151B22">
    <TextView
        android:id="@+id/habit_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:text="Hábitos · StudyDock" />
    <TextView
        android:id="@+id/habit_widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9EC5E8"
        android:textSize="11sp"
        android:paddingTop="2dp"
        android:text="28 dias" />
    <ImageView
        android:id="@+id/habit_widget_grid"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:contentDescription="Grid de hábitos" />
</LinearLayout>
