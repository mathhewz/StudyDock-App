<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclui credenciais e banco local com diário, refeições e treinos do backup em nuvem -->
        <exclude domain="sharedpref" path="studydock_secure_settings.xml" />
        <exclude domain="database" path="studydock.db" />
        <exclude domain="database" path="studydock.db-wal" />
        <exclude domain="database" path="studydock.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="studydock_secure_settings.xml" />
    </device-transfer>
</data-extraction-rules>
